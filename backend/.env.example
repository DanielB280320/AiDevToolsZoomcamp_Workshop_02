# Copy to backend/.env (never commit it). `make backend` loads it automatically.

# API-Football key from https://dashboard.api-football.com. When set, the API serves live standings,
# squads and results; leave it empty to serve the data in the database instead.
API_FOOTBALL_KEY=

# Database to connect to, as a SQLAlchemy URL. Missing tables are created at startup and an empty database is
# loaded with generated mock data. Defaults to a SQLite file at backend/kickboard.db.
# Other databases need their driver installed, e.g. `uv add psycopg` for postgresql+psycopg://user:password@localhost:5432/kickboard
# DATABASE_URL=sqlite:///kickboard.db

# Comma-separated browser origins allowed to call the API.
# KICKBOARD_CORS_ORIGINS=http://localhost:5173
